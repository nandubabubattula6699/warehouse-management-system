{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Run Warehouse Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "jinja": true
    },
    {
      "name": "Script: Test Database Connection",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_db_connection.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Script: Migrate Google Sheets / CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migrate_sheets.py",
      "args": ["data/sample_inventory.csv"],
      "console": "integratedTerminal"
    }
  ]
}
