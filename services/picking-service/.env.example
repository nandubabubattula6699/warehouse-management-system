# Inventory service (existing Warehouse OS app) base URL
INVENTORY_SERVICE_URL=http://localhost:8000
# Required. Must equal INTERNAL_API_KEY set on the inventory service (no default).
INTERNAL_API_KEY=change-me-to-a-long-random-secret
# Required. One entry per registered picking phone/scanner: name:token (token >= 24 chars).
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(24))"
PICK_DEVICE_TOKENS=scanner-1:replace-with-a-long-random-token-1,scanner-2:replace-with-a-long-random-token-2
# Optional: public URL to encode in QR codes (default: taken from the gateway request)
PUBLIC_BASE_URL=
