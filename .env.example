# PostgreSQL connection URL (required — the app refuses to start without it)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/warehouse_db

# AI packing-list reader (Google Gemini). Both required, otherwise the reader returns a clear error.
GEMINI_API_KEY=
GEMINI_MODEL=

# Browser origins allowed to call the API cross-origin (comma-separated, no '*').
# Leave empty if only the app's own pages call the API (same-origin needs no CORS).
ALLOWED_ORIGINS=

# Microservices
# Required for QR picking and vision lookups; same value on all services (no default).
INTERNAL_API_KEY=change-me-to-a-long-random-secret
# Required by picking-service (also when it is auto-started by this app): name:token,name:token
PICK_DEVICE_TOKENS=scanner-1:replace-with-a-long-random-token-1
PICKING_SERVICE_URL=http://localhost:8001
VISION_SERVICE_URL=http://localhost:8002
